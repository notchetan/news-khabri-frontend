{
  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/backend-cwd-guard.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/i18n-locale-check.js\"",
            "timeout": 30,
            "statusMessage": "Checking i18n placeholders..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/api-contract-check.js\"",
            "timeout": 15,
            "statusMessage": "Checking API paths against the backend..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/docs-pointer-check.js\"",
            "timeout": 15,
            "statusMessage": "Checking docs pointers..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/verify-on-stop.js\"",
            "timeout": 300,
            "statusMessage": "Typechecking and running tests..."
          }
        ]
      }
    ]
  }
}
